# EXAMPLE VALUES ONLY: replace these with values from your Azure deployment.
# This example hostname and key are fake and will not authenticate.
AZURE_OPENAI_ENDPOINT=https://billing-demo-resource.openai.azure.com
AZURE_OPENAI_API_KEY=0123456789abcdef0123456789abcdef
# Example deployment and model. Azure must have this deployment/model available.
AZURE_OPENAI_DEPLOYMENT=billing-gpt4o
AZURE_OPENAI_MODEL=gpt-4o
# Use the API version supported by your Azure deployment.
AZURE_OPENAI_API_VERSION=2024-06-01
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000
# Optional shared operator credential. Set before any non-loopback deployment.
BILLING_API_KEY=local-demo-token-change-me
# Separate admin login key (at least 16 characters, different from BILLING_API_KEY).
# Leave blank to disable admin mode. Generate your own random value; never use a demo key.
BILLING_ADMIN_API_KEY=
# Paths are relative to this project, unless absolute.
BILLING_DB=database/billing.db
CONTEXT_DB=database/context.db
INVOICE_DIR=database/invoices
CHAT_TIMEOUT_SECONDS=180
# Maximum sequential tool rounds per turn; simple answers stop sooner (2-20).
MAX_TOOL_ITERATIONS=12
SQL_MAX_ROWS=200
